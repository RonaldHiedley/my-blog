---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Ronald Hiedley">
    <section class="hero">
        <p class="eyebrow">Desenvolvedor de Software</p>

        <h1>Olá, eu sou o Ronald Hiedley.</h1>

        <p class="hero-description">
            Interessado em computação, sistemas, Linux e nas coisas que existem
            por trás do código.
        </p>

        <p class="hero-description">
            Este é meu espaço para construir, estudar e documentar.
        </p>

        <div class="hero-links">
            <a href="https://github.com/RonaldHiedley">GitHub →</a>
            <a href="https://www.linkedin.com/in/ronald-hiedley/">LinkedIn →</a>
        </div>
    </section>

    <hr />

    <section class="featured-projects">
        <p class="eyebrow">Construindo agora</p>

        <h2>TaskForge</h2>

        <p>
            Um sistema de gerenciamento de tarefas robusto construído com Java,
            Spring Boot e PostgreSQL.
        </p>

        <p class="tech-stack">
            Java · Spring Boot · PostgreSQL
        </p>

        <a href="/projetos/">Ver projeto →</a>
    </section>

    <hr />

    <section class="latest-projects">
        <p class="eyebrow">Últimos artigos</p>

        <h2>Artigos & Reflexões</h2>

        <p>
            Em breve, publicações sobre tecnologia, Linux, desenvolvimento de
            sistemas e computação.
        </p>

        <a href="/blog/">Ir para o Blog →</a>
    </section>
</MainLayout>

<style>
    .hero {
        padding: 48px 0 16px;
    }

    .eyebrow {
        margin-bottom: 16px;
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .hero h1 {
        max-width: 800px;
        margin-bottom: 24px;
    }

    .hero-description {
        max-width: 680px;
        margin-bottom: 8px;
        font-size: 1.05rem;
    }

    .hero-links {
        display: flex;
        gap: 24px;
        margin-top: 32px;
    }

    .hero-links a {
        font-family: var(--font-mono);
        font-size: 0.9rem;
    }

    .featured-projects,
    .latest-projects {
        padding: 16px 0;
    }

    .featured-projects h2,
    .latest-projects h2 {
        margin-bottom: 16px;
    }

    .featured-projects p,
    .latest-projects p {
        max-width: 700px;
    }

    .tech-stack {
        font-family: var(--font-mono);
        font-size: 0.85rem;
    }
</style>